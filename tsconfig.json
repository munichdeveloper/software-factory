{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "outDir": "dist", "rootDir": "src", "sourceMap": true, "declaration": true,
    "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
