{
  "name": "software-factory",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude tests/harness-integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude tests/harness-integration.test.ts",
    "schemas": "tsx scripts/schemas.ts",
    "check": "npm run build && npm run lint && npm test && npm run validate:workflows",
    "validate:workflows": "tsx scripts/validate-workflows.ts",
    "bundle": "tsx scripts/bundle.ts",
    "test:integration": "vitest run tests/harness-integration.test.ts",
    "contract": "tsx scripts/installation-contract.ts",
    "runtime:serve": "node dist/runtime/main.js serve",
    "runtime:worker": "node dist/runtime/main.js worker",
    "runtime:pack": "node dist/runtime/main.js pack",
    "test:runtime": "python3 scripts/test-runtime.py"
  },
  "dependencies": {
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "^22.0.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "ajv": "^8.20.0",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
