FROM node@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts/runtime-acceptance.ts ./scripts/runtime-acceptance.ts
COPY tests/helpers.ts ./tests/helpers.ts
COPY .runtime/harness/package.json .runtime/harness/package-lock.json ./.runtime/harness/
RUN cd .runtime/harness && npm ci --ignore-scripts
COPY .runtime/harness/tsconfig.json ./.runtime/harness/tsconfig.json
COPY .runtime/harness/src ./.runtime/harness/src
RUN npm run build && cd .runtime/harness && npm run build
CMD ["node", "--import", "tsx", "scripts/runtime-acceptance.ts"]
