{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "factory": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false
    },
    "manager": {
      "default": {},
      "type": "object",
      "properties": {
        "workflow": {
          "default": "factory-manager.yml",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.ya?ml$"
        },
        "maxActions": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeoutMinutes": {
          "default": 15,
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maxContextTasks": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxContextChars": {
          "default": 20000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000
        },
        "trustedActors": {
          "default": [
            "github-actions[bot]"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "autonomy": {
      "default": {},
      "type": "object",
      "properties": {
        "profile": {
          "default": "supervised",
          "type": "string",
          "enum": [
            "advisory",
            "supervised",
            "autonomous"
          ]
        },
        "overrides": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "transition",
              "close_issue",
              "create_followup",
              "prioritize",
              "approve_task",
              "start_worker",
              "retry_worker",
              "cancel_worker",
              "expand_scope",
              "merge_pr"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "approval"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "default": {},
      "type": "object",
      "properties": {
        "engine": {
          "default": "github-actions",
          "type": "string",
          "enum": [
            "github-actions",
            "temporal"
          ]
        },
        "dryRun": {
          "default": false,
          "type": "boolean"
        },
        "maxParallelWorkers": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxRetries": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "maxNewIssues": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "workerTimeoutMinutes": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "dispatchGraceMinutes": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "rework": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "llm": {
      "default": {},
      "type": "object",
      "properties": {
        "provider": {
          "default": "mock",
          "type": "string",
          "enum": [
            "mock",
            "openai"
          ]
        },
        "model": {
          "default": "gpt-4.1-mini",
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "maxOutputTokens": {
          "default": 4000,
          "type": "integer",
          "minimum": 256,
          "maximum": 16000
        },
        "timeoutSeconds": {
          "default": 60,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "maxCalls": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "workers": {
      "default": {},
      "type": "object",
      "properties": {
        "test": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "operation": {
              "default": "sha256",
              "type": "string",
              "enum": [
                "sha256",
                "fail",
                "blocked"
              ]
            }
          },
          "additionalProperties": false
        },
        "coding": {
          "default": false,
          "anyOf": [
            {
              "type": "boolean",
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "agent": {
                  "type": "string",
                  "const": "codex"
                },
                "model": {
                  "default": "gpt-6.1-sol",
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._-]{1,100}$"
                },
                "reasoningEffort": {
                  "default": "high",
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                },
                "validationWorkflow": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]+\\.ya?ml$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "loopback": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "enabled",
                "agent"
              ],
              "additionalProperties": false
            }
          ]
        },
        "review": {
          "default": false,
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "reporting": {
      "default": {},
      "type": "object",
      "properties": {
        "persistDecisions": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "merge": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "includeFactoryPRs": {
          "default": true,
          "type": "boolean"
        },
        "adoptLabel": {
          "default": "sf:automerge",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "method": {
          "default": "squash",
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        },
        "updateBranch": {
          "default": true,
          "type": "boolean"
        },
        "protection": {
          "default": "github",
          "type": "string",
          "enum": [
            "github",
            "factory"
          ]
        },
        "requiredChecks": {
          "default": [
            "test-backend",
            "test-frontend",
            "test-docker"
          ],
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "validationWorkflow": {
          "default": "test.yml",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.ya?ml$"
        },
        "maxReviewsPerRun": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "maxActionsPerRun": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "review": {
          "default": {},
          "type": "object",
          "properties": {
            "provider": {
              "default": "llm",
              "type": "string",
              "enum": [
                "llm",
                "openai"
              ]
            },
            "model": {
              "default": "gpt-6.1-sol",
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "reasoningEffort": {
              "default": "high",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            },
            "timeoutSeconds": {
              "default": 120,
              "type": "integer",
              "minimum": 10,
              "maximum": 120
            },
            "maxOutputTokens": {
              "default": 6000,
              "type": "integer",
              "minimum": 1000,
              "maximum": 12000
            },
            "maxFiles": {
              "default": 60,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxContextBytes": {
              "default": 250000,
              "type": "integer",
              "minimum": 10000,
              "maximum": 500000
            }
          },
          "additionalProperties": false
        },
        "postMergeWorkflows": {
          "default": [],
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+\\.ya?ml$"
          }
        }
      },
      "additionalProperties": false
    },
    "deploy": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "provider": {
          "default": "docker-ssh",
          "type": "string",
          "const": "docker-ssh"
        },
        "trigger": {
          "default": "checks",
          "type": "string",
          "enum": [
            "checks",
            "push"
          ]
        },
        "workflows": {
          "default": [],
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "environment": {
          "default": "production",
          "type": "string",
          "pattern": "^[A-Za-z0-9 ._-]{1,100}$"
        },
        "host": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$|^\\[?[0-9a-fA-F:.]+\\]?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "port": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "user": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "default": "/opt/app",
          "type": "string",
          "pattern": "^\\/(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$"
        },
        "composeFile": {
          "default": "compose.yaml",
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+\\.ya?ml$"
        },
        "project": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "envFile": {
          "default": ".env",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:\\/)?(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "healthcheck": {
          "default": {},
          "type": "object",
          "properties": {
            "url": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "timeoutSeconds": {
              "default": 180,
              "type": "integer",
              "minimum": 10,
              "maximum": 900
            }
          },
          "additionalProperties": false
        },
        "rollback": {
          "default": true,
          "type": "boolean"
        },
        "keepReleases": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "timeoutMinutes": {
          "default": 30,
          "type": "integer",
          "minimum": 5,
          "maximum": 60
        },
        "githubDeployment": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "default": {},
      "type": "object",
      "properties": {
        "slack": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "channel": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[CG][A-Z0-9]{8,}|#[a-z0-9_-]{1,80})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxPerRun": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "since": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "events": {
              "default": {},
              "type": "object",
              "properties": {
                "issue_created": {
                  "default": {},
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "default": false,
                      "type": "boolean"
                    },
                    "channel": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:[CG][A-Z0-9]{8,}|#[a-z0-9_-]{1,80})$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "pr_merged": {
                  "default": {},
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "default": false,
                      "type": "boolean"
                    },
                    "channel": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:[CG][A-Z0-9]{8,}|#[a-z0-9_-]{1,80})$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "actors": {
                      "default": [],
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+(?:\\[bot\\])?$"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "factory"
  ],
  "additionalProperties": false
}
