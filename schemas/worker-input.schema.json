{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0"
    },
    "repository": {
      "type": "string",
      "pattern": "^[\\w.-]+\\/[\\w.-]+$"
    },
    "issueNumber": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "taskVersion": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "acceptanceCriteria": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contextReferences": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "executionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "allowedActions": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "const": "publish_result"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maxOutputBytes": {
          "type": "number",
          "const": 16000
        }
      },
      "required": [
        "timeoutMinutes",
        "maxOutputBytes"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "enum": [
        "sha256",
        "fail",
        "blocked"
      ]
    }
  },
  "required": [
    "contractVersion",
    "repository",
    "issueNumber",
    "taskVersion",
    "description",
    "acceptanceCriteria",
    "contextReferences",
    "executionId",
    "allowedActions",
    "limits",
    "operation"
  ],
  "additionalProperties": false
}
