{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "actions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "transition",
              "close_issue",
              "create_followup",
              "prioritize",
              "approve_task",
              "start_worker",
              "retry_worker",
              "cancel_worker",
              "expand_scope",
              "merge_pr"
            ]
          },
          "issueNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "taskVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "backlog",
                  "ready",
                  "running",
                  "awaiting-pr",
                  "awaiting-approval",
                  "blocked",
                  "failed",
                  "done"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "high",
                  "normal",
                  "low"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "attempt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "followup": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 200
                  },
                  "context": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "acceptanceCriteria": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "dependencies": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "expandsScope": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "key",
                  "title",
                  "context",
                  "goal",
                  "acceptanceCriteria",
                  "dependencies",
                  "expandsScope"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "kind",
          "issueNumber",
          "taskVersion",
          "status",
          "priority",
          "attempt",
          "followup",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "actions"
  ],
  "additionalProperties": false
}
