{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "2.0"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "worker": {
      "type": "string",
      "const": "test"
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:/#._-]{0,199}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "acceptanceCriteria": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "contextReferences": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "required": [
        "id",
        "version",
        "description",
        "acceptanceCriteria",
        "contextReferences"
      ],
      "additionalProperties": false
    },
    "allowedActions": {
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "const": "run_test_operation"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16000
        }
      },
      "required": [
        "timeoutMs",
        "maxOutputBytes"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "enum": [
        "sha256",
        "fail",
        "blocked"
      ]
    }
  },
  "required": [
    "contractVersion",
    "executionId",
    "worker",
    "task",
    "allowedActions",
    "limits",
    "operation"
  ],
  "additionalProperties": false
}
